# 服务
NODE_ENV=development
HOST=127.0.0.1
PORT=3110
PUBLIC_BASE_URL=http://127.0.0.1:3110
DATABASE_PATH=./data/merchant-gateway.sqlite
TRUST_PROXY=false

# 平台调用你方接口；生产请生成 32 字节以上随机值
PLATFORM_API_KEY=replace-with-platform-api-key
PLATFORM_ALLOWED_IPS=127.0.0.1,::1
PLATFORM_WEBHOOK_ENABLED=false
PLATFORM_WEBHOOK_URL=
PLATFORM_WEBHOOK_SECRET=replace-with-a-different-webhook-secret

# 内部运维接口
ADMIN_TOKEN=replace-with-admin-token

# 32 字节 Base64 密钥，可用：openssl rand -base64 32
SESSION_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
EMAIL_HMAC_KEY=replace-with-email-hmac-key

# 商品配置。正式开售前修改价格并把 enabled 改为 true。
PRODUCT_CATALOG_PATH=./config/products-x-partner.json
PARTNER_SALES_GATE_FILE=./data/control/sales.enabled
QUEFA_WORKER_GATE_FILE=./data/control/workers.enabled

# 支付宝：开发阶段用 mock，生产改为 alipay
PAYMENT_PROVIDER=mock
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SELLER_ID=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=https://api.quefa.cn/bluev/callbacks/alipay
ALIPAY_RETURN_URL=https://api.quefa.cn

# 历史兼容配置：独立蓝V服务不使用 ZovoCard
ZOVO_MODE=mock
ZOVO_BASE_URL=https://zovocard.com
ZOVO_APP_ID=
ZOVO_API_KEY=
ZOVO_REQUEST_TIMEOUT_MS=15000

# 蓝V直充：我方确认收款后，由服务端签名提交到 x.aifu.me。
# 密钥仅可放在服务端环境变量，禁止交给网页前端。
X_API_MODE=disabled
X_API_BASE_URL=https://x.aifu.me
X_API_PARTNER_ID=
X_API_KEY_ID=
X_API_SECRET=
X_API_REQUEST_TIMEOUT_MS=15000

# 后台任务
ACTIVATION_POLL_INTERVAL_MS=3000
WEBHOOK_POLL_INTERVAL_MS=5000
